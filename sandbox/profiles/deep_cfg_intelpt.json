{
  "profile_name": "deep_cfg_intelpt",
  "trace_mode": "dynamic_cfg",
  "trace_backend": "intelpt",
  "network_mode": "airgap",
  "user_simulation": "none",
  "execution_window_seconds": 180,
  "boot_stabilization_seconds": 30,
  "backend_options": {
